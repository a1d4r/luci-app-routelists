msgid "%d entry"
msgid_plural "%d entries"
msgstr[0] "%d запись"
msgstr[1] "%d записи"
msgstr[2] "%d записей"

msgid "%d error"
msgid_plural "%d errors"
msgstr[0] "%d ошибка"
msgstr[1] "%d ошибки"
msgstr[2] "%d ошибок"

msgid "%d warning"
msgid_plural "%d warnings"
msgstr[0] "%d предупреждение"
msgstr[1] "%d предупреждения"
msgstr[2] "%d предупреждений"

msgid "%s, %s, %s"
msgstr "%s, %s, %s"

msgid "A list named \"%s\" already exists."
msgstr "Список с именем «%s» уже существует."

msgid "Actions"
msgstr "Действия"

msgid "Add"
msgstr "Добавить"

msgid "After saving a list, show a reminder that changes take effect only after applying them to ZeroBlock."
msgstr "После сохранения списка показывать напоминание, что изменения вступят в силу только после применения в ZeroBlock."

msgid "Allowed in modes"
msgstr "Допустим в режимах"

msgid "Apply ZeroBlock changes"
msgstr "Применить изменения ZeroBlock"

msgid "Attaching a list to a ZeroBlock section"
msgstr "Подключение списка к секции ZeroBlock"

msgid "Auto"
msgstr "Авто"

msgid "Auto, Domains only"
msgstr "Авто, Только домены"

msgid "Auto, IP only"
msgstr "Авто, Только IP"

msgid "Backups"
msgstr "Резервные копии"

msgid "Cancel"
msgstr "Отмена"

msgid "Check mode"
msgstr "Режим проверки"

msgid "Check modes"
msgstr "Режимы проверки"

msgid "Comment line"
msgstr "Строка-комментарий"

msgid "Comments"
msgstr "Комментарии"

msgid "Copied"
msgstr "Скопировано"

msgid "Copy path"
msgstr "Копировать путь"

msgid "Copy the list path on the Lists tab (\"Copy path\")."
msgstr "Скопируйте путь списка на вкладке «Списки» (кнопка «Копировать путь»)."

msgid "Delete"
msgstr "Удалить"

msgid "Delete list"
msgstr "Удаление списка"

msgid "Delete list \"%s\"? The file will be removed permanently."
msgstr "Удалить список «%s»? Файл будет удалён безвозвратно."

msgid "Deleting lists that are in use"
msgstr "Удаление используемых списков"

msgid "Domain"
msgstr "Домен"

msgid "Domains only"
msgstr "Только домены"

msgid "Edit"
msgstr "Редактировать"

msgid "Edit list"
msgstr "Редактирование списка"

msgid "Empty line"
msgstr "Пустая строка"

msgid "Full-line comments (# ...) are ignored by ZeroBlock and are valid here. An inline comment after an entry (%s) is still flagged: it is not documented, and ZeroBlock's auto-detection is binary — a line with \"/\" or consisting of digits and dots is treated as IP/CIDR, everything else silently becomes a \"domain\". That is also why invalid lines are worth fixing: ZeroBlock will never report them."
msgstr "Строки-комментарии (# ...) ZeroBlock игнорирует — здесь они валидны. Inline-комментарий после записи (%s) по-прежнему помечается: он не документирован, а автодетект ZeroBlock бинарный — строка с «/» или состоящая из цифр и точек считается IP/CIDR, всё остальное молча становится «доменом». Поэтому же стоит исправлять невалидные строки: сам ZeroBlock о них никогда не сообщит."

msgid "Entries"
msgstr "Записей"

msgid "?"
msgstr "?"

msgid "Entry formats verified against ZeroBlock full manual v0.8.4-r248, section 11."
msgstr "Форматы записей сверены с полным руководством ZeroBlock v0.8.4-r248, раздел 11."

msgid "Example"
msgstr "Пример"

msgid "Failed to create list: %s"
msgstr "Не удалось создать список: %s"

msgid "Failed to delete list: %s"
msgstr "Не удалось удалить список: %s"

msgid "Failed to read the list file: %s. The editor stays closed so that the "
"file cannot be overwritten with empty content."
msgstr "Не удалось прочитать файл списка: %s. Редактор не открыт, чтобы файл "
"нельзя было перезаписать пустым содержимым."

msgid "Failed to run ZeroBlock reload: %s"
msgstr "Не удалось выполнить ZeroBlock reload: %s"

msgid "Failed to save list: %s"
msgstr "Не удалось сохранить список: %s"

msgid "Format"
msgstr "Формат"

msgid "Grant access to LuCI user route lists app"
msgstr "Предоставить доступ к приложению пользовательских списков маршрутов LuCI"

msgid "Help"
msgstr "Справка"

msgid "IP only"
msgstr "Только IP"

msgid "IPv4"
msgstr "IPv4"

msgid "IPv4 CIDR"
msgstr "IPv4 CIDR"

msgid "IPv6"
msgstr "IPv6"

msgid "IPv6 CIDR"
msgstr "IPv6 CIDR"

msgid "If a file referenced by a ZeroBlock section disappears, then depending on lists_failure_mode the section may be disabled (degrade) or the whole proxy service may stop (teardown). Remove the path from the sections before deleting a list."
msgstr "Если файл, на который ссылается секция ZeroBlock, исчезнет, то в зависимости от lists_failure_mode секция может отключиться (degrade) или остановится весь прокси-сервис (teardown). Уберите путь из секций до удаления списка."

msgid "Invalid list name — allowed: letters, digits, \"-\" and \"_\", at most 32 characters."
msgstr "Недопустимое имя списка — разрешены латинские буквы, цифры, «-» и «_», не более 32 символов."

msgid "Leave"
msgstr "Уйти"

msgid "List name"
msgstr "Имя списка"

msgid "Lists"
msgstr "Списки"

msgid "Name"
msgstr "Название"

msgid "No lists yet. Create the first one and attach it to a ZeroBlock section via its file path."
msgstr "Списков пока нет. Создайте первый — и подключите к секции ZeroBlock по пути к файлу."

msgid "Not saved: the file exceeds the %d KiB limit."
msgstr "Не сохранено: файл превышает лимит %d КиБ."

msgid "Not saved: the list has problems. Fix them or use \"Save with warnings/errors\"."
msgstr "Не сохранено: в списке есть проблемы. Исправьте их или используйте «Сохранить с предупреждениями/ошибками»."

msgid "One entry per line, plain text. The following are rejected as errors because the ZeroBlock file contract explicitly excludes them: %s prefixes, hosts-style lines (%s) and adblock syntax (%s). Those notations only work when entered manually inside a ZeroBlock section, not in list files."
msgstr "Одна запись на строку, обычный текст. Следующее отклоняется как ошибка, поскольку контракт файлов ZeroBlock явно это исключает: префиксы %s, hosts-строки (%s) и adblock-синтаксис (%s). Эти нотации работают только при ручном вводе внутри секции ZeroBlock, но не в файлах списков."

msgid "Open the desired section in ZeroBlock."
msgstr "Откройте нужную секцию в ZeroBlock."

msgid "Paste the path into the \"User lists\" field and apply."
msgstr "Вставьте путь в поле «Пользовательские списки» и примените."

msgid "Paste this path into the \"User lists\" field of a ZeroBlock section"
msgstr "Вставьте этот путь в поле «Пользовательские списки» секции ZeroBlock"

msgid "Path"
msgstr "Путь"

msgid "Public, ready-made lists are better attached directly by URL in ZeroBlock; this app is for maintaining your own local lists."
msgstr "Готовые публичные списки лучше подключать в ZeroBlock напрямую по URL; это приложение — для ведения собственных локальных списков."

msgid "Remove duplicates"
msgstr "Удалить дубликаты"

msgid "Save"
msgstr "Сохранить"

msgid "Save & Apply"
msgstr "Сохранить и применить"

msgid "Save with warnings/errors"
msgstr "Сохранить с предупреждениями/ошибками"

msgid "Saved. Changes take effect after applying them to ZeroBlock."
msgstr "Сохранено. Изменения вступят в силу после применения в ZeroBlock."

msgid "Settings"
msgstr "Настройки"

msgid "Size"
msgstr "Размер"

msgid "Stay"
msgstr "Остаться"

msgid "Storage directory"
msgstr "Каталог хранения"

msgid "Suggest applying ZeroBlock after saving"
msgstr "Предлагать применение ZeroBlock после сохранения"

msgid "Supported entry formats"
msgstr "Поддерживаемые форматы записей"

msgid "Switch to its Lists tab."
msgstr "Перейдите на её вкладку «Списки»."

msgid "The check mode only affects validation in this app; ZeroBlock itself always auto-detects each line. \"Auto\" accepts every valid entry type, \"Domains only\" and \"IP only\" restrict the list to one entry type — useful to catch mistakes in lists meant for a single purpose."
msgstr "Режим проверки влияет только на валидацию в этом приложении; сам ZeroBlock всегда автоматически определяет тип каждой строки. «Авто» принимает все валидные типы записей, «Только домены» и «Только IP» ограничивают список одним типом — это помогает ловить ошибки в списках, предназначенных для одной цели."

msgid "The directory is fixed by the access policy (ACL). Changing it is only possible by editing the ACL file manually."
msgstr "Каталог фиксирован политикой доступа (ACL). Сменить его можно только правкой ACL-файла вручную."

msgid "The list has unsaved changes. Leave without saving?"
msgstr "В списке есть несохранённые изменения. Уйти без сохранения?"

msgid "The lists (/etc/user-lists) and this app's settings are included in the standard LuCI configuration backup. A sysupgrade without keeping settings erases them — make a backup before flashing."
msgstr "Списки (/etc/user-lists) и настройки этого приложения входят в штатную резервную копию конфигурации LuCI. Sysupgrade без сохранения настроек стирает их — сделайте резервную копию перед прошивкой."

msgid "This file is referenced by ZeroBlock section(s): %s. Depending on lists_failure_mode, a missing file may disable the section or stop the whole proxy service (teardown). Remove the path from the sections first."
msgstr "На этот файл ссылаются секции ZeroBlock: %s. В зависимости от lists_failure_mode отсутствующий файл может отключить секцию или остановить весь прокси-сервис (teardown). Сначала уберите путь из секций."

msgid "This file is referenced by ZeroBlock section(s): %s. The paths there are not updated automatically — fix them manually after renaming."
msgstr "На этот файл ссылаются секции ZeroBlock: %s. Пути в них не обновляются автоматически — поправьте их вручную после переименования."

msgid "This list is larger than %d KiB and cannot be saved back — the editor "
"is read-only. Edit the file over SSH."
msgstr "Этот список больше %d КиБ и не может быть сохранён обратно — редактор "
"работает только на чтение. Правьте файл по SSH."

msgid "Unsaved changes"
msgstr "Несохранённые изменения"

msgid "User Lists"
msgstr "Пользовательские списки"

msgid "User Lists — Help"
msgstr "Пользовательские списки — Справка"

msgid "User Lists — Settings"
msgstr "Пользовательские списки — Настройки"

msgid "User list files (domains / IP / CIDR) stored in %s. Attach a list to a ZeroBlock section by pasting its file path into the section's \"User lists\" field."
msgstr "Файлы пользовательских списков (домены / IP / CIDR) в каталоге %s. Подключите список к секции ZeroBlock, вставив путь к файлу в поле «Пользовательские списки» секции."

msgid "ZeroBlock reload failed: %s"
msgstr "ZeroBlock reload завершился с ошибкой: %s"

msgid "ZeroBlock reload finished successfully."
msgstr "ZeroBlock reload выполнен успешно."

msgid "adblock syntax is explicitly excluded by the ZeroBlock file contract (manual 11.1)"
msgstr "adblock-синтаксис явно исключён контрактом файлов ZeroBlock (manual 11.1)"

msgid "all"
msgstr "все"

msgid "duplicate of line %d"
msgstr "дубликат строки %d"

msgid "hosts-style format is explicitly excluded by the ZeroBlock file contract (manual 11.1)"
msgstr "hosts-формат явно исключён контрактом файлов ZeroBlock (manual 11.1)"

msgid "inline comments are not documented by ZeroBlock — the whole line may be interpreted as a domain"
msgstr "inline-комментарии не документированы ZeroBlock — вся строка может быть интерпретирована как домен"

msgid "line %d: %s"
msgstr "строка %d: %s"

msgid "non-ASCII (IDN) domain is not documented by ZeroBlock — consider the punycode form: %s"
msgstr "IDN-домен (не-ASCII) не документирован ZeroBlock — рассмотрите punycode-вариант: %s"

msgid "not a domain (this list allows domains only)"
msgstr "не домен (в этом списке разрешены только домены)"

msgid "not a domain or IP/CIDR"
msgstr "не домен и не IP/CIDR"

msgid "not an IP/CIDR (this list allows IP entries only)"
msgstr "не IP/CIDR (в этом списке разрешены только IP-записи)"

msgid "prefixes are not supported in list files (ZeroBlock contract, manual 11.1) — they only work when entered manually in a section"
msgstr "префиксы не поддерживаются в файлах списков (контракт ZeroBlock, manual 11.1) — они работают только при ручном вводе в секции"

msgid "…and %d more problem not shown"
msgid_plural "…and %d more problems not shown"
msgstr[0] "…и ещё %d проблема не показана"
msgstr[1] "…и ещё %d проблемы не показаны"
msgstr[2] "…и ещё %d проблем не показано"
